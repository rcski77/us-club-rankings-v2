// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Phase 0: reference / org data + auth -----------------------------------
// See plan section 1.1/1.2 (C:\Users\adam\.claude\plans\i-need-to-do-fancy-kay.md)

enum UsavZone {
  ATLANTIC
  BORDER
  CENTRAL
  PACIFIC
}

model Region {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique // 2-char, e.g. "NT", "AZ", "SC" -- matches the region
  // codes embedded in AES team codes (see Team.externalTeamCode).
  zone      UsavZone?
  clubs     Club[]
  createdAt DateTime  @default(now())
}

model Season {
  id          String       @id @default(cuid())
  label       String       @unique // e.g. "2025-2026"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(false)
  teamSeasons TeamSeason[]
  events      Event[]
  createdAt   DateTime     @default(now())
}

model Club {
  id           String        @id @default(cuid())
  name         String // admin-maintained; the "club code registry" -- named once,
  // reused by every future import referencing the same externalCode+region.
  slug         String        @unique
  externalCode String? // 5-char AES club code, e.g. "frogs", "skyln". Nullable:
  // not every club arrives via a source with a stable code (e.g. manual entry).
  regionId     String?
  region       Region?       @relation(fields: [regionId], references: [id])
  city         String?
  state        String?
  zip          String?
  isActive     Boolean       @default(true)
  teams        Team[]
  contacts     ClubContact[]
  importRows   ImportRow[]
  auditFlags   AuditFlag[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Confirmed from a real AES sample: the 5-char code alone is not globally unique
  // (e.g. "skyln" is used by a Dallas-area club under region NT and a
  // Jacksonville-area club under region FL) -- the compound key is.
  @@unique([externalCode, regionId])
}

model ClubContact {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  title     String?
  createdAt DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PENDING
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  passwordHash  String // scrypt-hashed, format "salt:hash" (see src/lib/password.ts)
  role          UserRole      @default(PENDING)
  status        UserStatus    @default(PENDING)
  createdAt     DateTime      @default(now())
  importBatches ImportBatch[]
}

// Team is a persistent identity (a program's squad), independent of season -- it can
// participate in multiple seasons via TeamSeason. Fields that genuinely vary year to
// year (age group, squad number, the AES-style code that embeds the age digit) live on
// TeamSeason, not here. Results are filtered by season via TeamFinish -> Division ->
// Event -> Season, not via a fixed field on Team itself.
model Team {
  id     String  @id @default(cuid())
  clubId String? // nullable: "Unlinked Teams" -- a team whose club code didn't
  // resolve to a known Club yet (staged for admin to name, not fuzzy-guessed).
  club   Club?   @relation(fields: [clubId], references: [id])

  name       String // display name, e.g. "MADFROG Green"
  lineageKey String? // derived from (club externalCode+region, teamNumber) -- stable
  // across seasons even as the age-group digit in the source code changes; powers
  // cross-season rating carry-forward and "same program as last year" suggestions.

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons        TeamSeason[]
  finishes       TeamFinish[]
  rankingResults RankingResult[]
  importRows     ImportRow[]
  auditFlags     AuditFlag[]

  @@index([lineageKey])
}

// One row per (team, season) it participates in -- this is what "a team belongs to
// multiple seasons" means concretely: age group and squad number are season-scoped
// facts about a team, not permanent ones.
model TeamSeason {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  ageGroup         Int
  teamNumber       String // distinguishes a club's multiple squads in the same age
  // group (legacy's "17-1"/"17-2"), parsed from the source code for that season.
  // String, not Int: confirmed from real AES data that this segment of the source
  // code can be alphanumeric (e.g. a lettered designator), not just a digit.
  externalTeamCode String? // raw source code verbatim for that season, e.g.
  // "g14skyln1nt" -- the leading age digit changes season to season, which is exactly
  // why this can't live on Team.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, seasonId])
  @@index([seasonId, ageGroup])
}

// --- Phase 1: events, divisions, point templates, finishes, rankings --------
// See plan section 1.3/1.4 (manual-parity subset; rating-engine models come later)

model Event {
  id          String   @id @default(cuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  name        String
  slug        String   @unique
  startDate   DateTime
  endDate     DateTime
  addressLine String?
  city        String?
  state       String?
  zip         String?
  isAnchor    Boolean  @default(false) // USAV Nationals / Triple Crown NIT -- exempt
  // from the future suggestion algorithm (Phase 4+); manually assigned max-value
  // templates always.
  divisions     Division[]
  importBatches ImportBatch[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum DivisionTierLabel {
  OPEN
  NATIONAL
  AMERICAN
  PATRIOT
  LIBERTY
  USA
  FREEDOM
}

enum DivisionScoringStatus {
  DRAFT
  SUGGESTED
  CONFIRMED
}

model Division {
  id                String                @id @default(cuid())
  eventId           String
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String // e.g. "17 Open"
  slug              String
  ageGroup          Int
  tierLabel         DivisionTierLabel
  tierLevel         String? // e.g. "I" / "II" -- separate roman-numeral axis
  scoringStatus     DivisionScoringStatus @default(DRAFT)
  ignoreAgeDefault  Boolean               @default(false)
  pointBands        DivisionPointBand[]
  finishes          TeamFinish[]
  importRows        ImportRow[]
  auditFlags        AuditFlag[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([eventId, slug])
}

model PointTemplate {
  id              String              @id @default(cuid())
  name            String              @unique
  description     String?
  maxPoints       Int // denormalized top-band value, for sorting/display
  isAnchorTemplate Boolean            @default(false)
  isSystem        Boolean             @default(false)
  bands           PointTemplateBand[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PointTemplateBand {
  id              String        @id @default(cuid())
  pointTemplateId String
  pointTemplate   PointTemplate @relation(fields: [pointTemplateId], references: [id], onDelete: Cascade)
  fromRank        Int
  toRank          Int // 0 means "and beyond" (open-ended tail band), matching the
  // legacy convention seen in the admin screenshots.
  points          Int

  @@unique([pointTemplateId, fromRank])
}

model DivisionPointBand {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  fromRank   Int
  toRank     Int // 0 = open-ended tail band
  points     Int

  @@unique([divisionId, fromRank])
}

model TeamFinish {
  id             String   @id @default(cuid())
  divisionId     String
  division       Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  rank           Int // may repeat across rows for ties
  tiebreakOrder  Int? // AES-embedded unique seed/order number, display/ordering only
  points         Int? // resolved from DivisionPointBand at confirm time; null until then
  ignoreAge      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rankingContributions RankingResultContribution[]

  @@unique([divisionId, teamId])
  @@index([teamId])
}

model RankingResult {
  id             String   @id @default(cuid())
  seasonId       String
  ageGroup       Int
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  totalPoints    Int
  rank           Int
  weightedRank   Int
  algorithmVersion String @default("phase1-points-only")
  computedAt     DateTime @default(now())

  contributions RankingResultContribution[]

  @@unique([seasonId, ageGroup, teamId])
  @@index([seasonId, ageGroup, rank])
}

model RankingResultContribution {
  id              String        @id @default(cuid())
  rankingResultId String
  rankingResult   RankingResult @relation(fields: [rankingResultId], references: [id], onDelete: Cascade)
  teamFinishId    String
  teamFinish      TeamFinish    @relation(fields: [teamFinishId], references: [id], onDelete: Cascade)
  points          Int
  rankInSeason    Int // 1st/2nd/3rd/4th... best finish, by points descending
  countedInTop3   Boolean

  @@unique([rankingResultId, teamFinishId])
}

// --- Phase 2: CSV import pipeline (AES adapter, TEAM_FINISHES only) ---------
// See docs/plan.md Phase 2 section for the full resolve/commit algorithm.

enum ImportSource {
  AES
  SPORTWRENCH
  TM2
  VBSCHEDULE
  MANUAL
}

enum ImportType {
  DIVISIONS
  TEAM_FINISHES
  MATCH_RESULTS
}

enum ImportBatchStatus {
  DRAFT
  RESOLVED
  COMMITTED
  FAILED
}

enum ImportFileStatus {
  UPLOADED
  PARSED
  ERROR
}

enum ImportRowStatus {
  PENDING
  OK
  WARNING
  ERROR
}

enum ImportMatchType {
  EXISTING
  NEW
  AMBIGUOUS
}

enum AuditFlagType {
  NEW_CLUB
  NEW_TEAM
  NEW_DIVISION
  REGION_MISMATCH
  TIER_DEFAULTED
  DUPLICATE_IN_IMPORT
  REIMPORT_UPDATE
  OTHER
}

// One import batch targets a single Event -- an AES file spans that whole event's
// age groups/tiers at once, so one batch's commit can create/touch many Divisions.
model ImportBatch {
  id          String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id])
  source      ImportSource      @default(AES)
  importType  ImportType        @default(TEAM_FINISHES)
  status      ImportBatchStatus @default(DRAFT)
  summaryJson Json? // display cache of row-status + new-club/team/division counts,
  // refreshed after resolve/commit -- mirrors the Division.scoringStatus-coarse-field
  // / audit-trail-detail pattern used elsewhere; ImportRow is the real detail.
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  files       ImportFile[]
  auditFlags  AuditFlag[]
  committedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ImportFile {
  id            String           @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  filename      String
  partNumber    Int? // parsed from "_part1"/"_part2" in filename; null for a single-file batch
  rawContent    String // full CSV text -- stored directly (no blob storage exists in
  // this project; AES's ~300-line-per-file cap keeps this small), also lets "resolve"
  // replay from scratch without re-upload.
  status     ImportFileStatus @default(UPLOADED)
  parseError String?
  rowCount   Int              @default(0)
  rows       ImportRow[]
  createdAt  DateTime         @default(now())

  @@unique([importBatchId, filename])
}

// Staging row for the preview screen. Raw AES columns are explicit typed fields
// (not a generic JSON blob) since AES's 4-column shape is fixed and known.
model ImportRow {
  id           String     @id @default(cuid())
  importFileId String
  importFile   ImportFile @relation(fields: [importFileId], references: [id], onDelete: Cascade)
  rowNumber    Int // 1-based row number within the file, for error display

  // raw, exactly as read from the CSV's 4 AES columns
  ageGroupLabelRaw String
  rankRaw          String
  teamNameRaw      String
  teamCodeRaw      String

  // parsed, populated by resolveImportBatch()
  parsedRank               Int?
  parsedAgeGroup            Int?
  parsedTierLabel           DivisionTierLabel?
  parsedTierLevel           String?
  tierWasDefaulted          Boolean            @default(false)
  parsedGender              String? // audit-only -- not modeled anywhere downstream
  parsedClubExternalCode    String?
  parsedTeamNumber          String? // alphanumeric -- see TeamSeason.teamNumber
  parsedRegionCodeFromCode  String?
  parsedRegionCodeFromName  String?
  parsedTiebreakOrder       Int?
  teamNameClean             String?

  // resolve output
  status   ImportRowStatus @default(PENDING)
  messages String[]

  divisionMatchType ImportMatchType?
  matchedDivisionId String?
  matchedDivision   Division? @relation(fields: [matchedDivisionId], references: [id])

  clubMatchType ImportMatchType?
  matchedClubId String?
  matchedClub   Club? @relation(fields: [matchedClubId], references: [id])

  teamMatchType ImportMatchType?
  matchedTeamId String?
  matchedTeam   Team? @relation(fields: [matchedTeamId], references: [id])

  existingTeamFinishId String? // set when TeamFinish(divisionId,teamId) already
  // exists -- commit updates it instead of erroring (re-import idempotency).

  // admin overrides -- sticky across re-resolve. Plain id strings, not relations:
  // write-mostly pointer fields, not worth six more relation names to the same
  // three target models.
  overrideDivisionId String?
  overrideClubId     String?
  overrideTeamId     String?
  overrideClubName   String? // required before commit whenever the effective club match is NEW
  excluded           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importFileId])
  @@index([status])
}

model AuditFlag {
  id            String        @id @default(cuid())
  importBatchId String?
  importBatch   ImportBatch?  @relation(fields: [importBatchId], references: [id])
  type          AuditFlagType
  message       String
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id])
  clubId        String?
  club          Club?         @relation(fields: [clubId], references: [id])
  divisionId    String?
  division      Division?     @relation(fields: [divisionId], references: [id])
  resolved      Boolean       @default(false) // no UI to flip this yet -- Phase 6 (/admin/flags)
  createdAt     DateTime      @default(now())
}
