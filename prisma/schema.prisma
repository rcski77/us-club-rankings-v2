// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Phase 0: reference / org data + auth -----------------------------------
// See plan section 1.1/1.2 (C:\Users\adam\.claude\plans\i-need-to-do-fancy-kay.md)

enum UsavZone {
  ATLANTIC
  BORDER
  CENTRAL
  PACIFIC
}

model Region {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique // 2-char, e.g. "NT", "AZ", "SC" -- matches the region
  // codes embedded in AES team codes (see Team.externalTeamCode).
  zone      UsavZone?
  clubs     Club[]
  createdAt DateTime  @default(now())
}

model Season {
  id          String       @id @default(cuid())
  label       String       @unique // e.g. "2025-2026"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(false)
  teamSeasons TeamSeason[]
  events      Event[]
  ratingHistory TeamRatingHistory[]
  clubRankingResults ClubRankingResult[]
  eloMatchSteps TeamEloMatchStep[]
  createdAt   DateTime     @default(now())
}

model Club {
  id           String        @id @default(cuid())
  name         String // admin-maintained; the "club code registry" -- named once,
  // reused by every future import referencing the same externalCode+region.
  slug         String        @unique
  externalCode String? // 5-char AES club code, e.g. "frogs", "skyln". Nullable:
  // not every club arrives via a source with a stable code (e.g. manual entry).
  regionId     String?
  region       Region?       @relation(fields: [regionId], references: [id])
  city         String?
  state        String?
  zip          String?
  isActive     Boolean       @default(true)
  mergedIntoClubId String?   // set when this club's history was merged into another
  // Club (e.g. a real-world club merger under a new code, or an admin-corrected
  // duplicate) -- see mergeClubsIntoTarget() in src/lib/club/mergeClubs.ts. The row
  // itself is kept (not deleted) for audit trail/FK integrity on historical
  // ImportRow/AuditFlag references; isActive is set to false alongside this so it
  // drops out of normal club lists. Import resolution (resolve.ts) follows this
  // pointer so a stray import row still using this club's old external code resolves
  // to the surviving club instead of resurrecting this one.
  mergedInto       Club?     @relation("ClubMerge", fields: [mergedIntoClubId], references: [id])
  mergedClubs      Club[]    @relation("ClubMerge")
  rankingGroupPrimaryClubId String? // set when this club stays fully independent
  // (its own teams, its own imports, its own detail page) but its results should
  // roll up into another club's ClubRankingResult for club-rankings purposes only --
  // e.g. two active locations of one real program, each with its own external code
  // (the "FORZA1 / FORZA1 NORTH" case). Unlike mergedIntoClubId, nothing else about
  // this club changes: isActive stays true, Team rows stay put, and import
  // resolution does NOT redirect through this pointer (each location keeps matching
  // its own code). Only computeClubRankingForSeason() reads it, to fold this club's
  // best-per-age-group teams into the target's rollup instead of publishing a
  // separate (weaker, partial) ClubRankingResult for this club. Null on the target
  // club itself and on every club not in a ranking group.
  rankingGroupPrimary Club?  @relation("ClubRankingGroup", fields: [rankingGroupPrimaryClubId], references: [id])
  rankingGroupMembers Club[] @relation("ClubRankingGroup")
  teams        Team[]
  contacts     ClubContact[]
  importRows   ImportRow[]
  auditFlags   AuditFlag[]
  clubRankingResults ClubRankingResult[]
  annualScores          ClubAnnualScore[]
  annualAgeGroupScores  ClubAnnualAgeGroupScore[]
  fiveYearRankingResults ClubFiveYearRankingResult[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Confirmed from a real AES sample: the 5-char code alone is not globally unique
  // (e.g. "skyln" is used by a Dallas-area club under region NT and a
  // Jacksonville-area club under region FL) -- the compound key is.
  @@unique([externalCode, regionId])
  @@index([regionId])
}

model ClubContact {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  title     String?
  createdAt DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PENDING
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  passwordHash  String // scrypt-hashed, format "salt:hash" (see src/lib/password.ts)
  role          UserRole      @default(PENDING)
  status        UserStatus    @default(PENDING)
  createdAt     DateTime      @default(now())
  importBatches ImportBatch[]
  sessions      Session[]
}

// Hand-rolled DB-backed session (not Auth.js's built-in "database" strategy -- Auth.js
// refuses that strategy with a Credentials-only provider; see src/lib/session.ts).
// Only tokenHash is stored, never the raw cookie value, so reading this table can't be
// replayed as a valid session the way a leaked plaintext token could.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Team is a persistent identity (a program's squad), independent of season -- it can
// participate in multiple seasons via TeamSeason. Fields that genuinely vary year to
// year (age group, squad number, the AES-style code that embeds the age digit) live on
// TeamSeason, not here. Results are filtered by season via TeamFinish -> Division ->
// Event -> Season, not via a fixed field on Team itself.
model Team {
  id     String  @id @default(cuid())
  clubId String? // nullable: "Unlinked Teams" -- a team whose club code didn't
  // resolve to a known Club yet (staged for admin to name, not fuzzy-guessed).
  club   Club?   @relation(fields: [clubId], references: [id])

  name       String // display name, e.g. "MADFROG Green"
  lineageKey String? // derived from (gender, club externalCode+region, teamNumber) --
  // stable across seasons even as the age-group digit in the source code changes;
  // powers cross-season rating carry-forward and "same program as last year"
  // suggestions.
  gender     DivisionGender @default(GIRLS) // authoritative from the team's own code
  // (see aesTeamCode.ts) at creation time -- default GIRLS matches every team created
  // before this field existed, same convention as Division.gender. Included in
  // lineageKey specifically so a club's boys and girls squads sharing a club
  // code/region/team number never resolve to the same Team (see docs/plan.md
  // postmortem on the "Mintonette" cross-gender merge bug this fixes).

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons          TeamSeason[]
  finishes         TeamFinish[]
  rankingResults   RankingResult[]
  ratingHistory    TeamRatingHistory[]
  importRows       ImportRow[]
  auditFlags       AuditFlag[]
  matchesAsTeamA   Match[]             @relation("MatchTeamA")
  matchesAsTeamB   Match[]             @relation("MatchTeamB")
  matchesWon       Match[]             @relation("MatchWinner")
  clubRankingContributions ClubRankingResultContribution[]
  eloMatchSteps        TeamEloMatchStep[] @relation("TeamEloMatchStepTeam")
  eloMatchStepsAsOpponent TeamEloMatchStep[] @relation("TeamEloMatchStepOpponent")

  @@index([lineageKey])
  @@index([clubId])
}

// One row per (team, season) it participates in -- this is what "a team belongs to
// multiple seasons" means concretely: age group and squad number are season-scoped
// facts about a team, not permanent ones.
model TeamSeason {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  ageGroup         Int
  teamNumber       String // distinguishes a club's multiple squads in the same age
  // group (legacy's "17-1"/"17-2"), parsed from the source code for that season.
  // String, not Int: confirmed from real AES data that this segment of the source
  // code can be alphanumeric (e.g. a lettered designator), not just a digit.
  externalTeamCode String? // raw source code verbatim for that season, e.g.
  // "g14skyln1nt" -- the leading age digit changes season to season, which is exactly
  // why this can't live on Team.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, seasonId])
  @@index([seasonId, ageGroup])
}

// --- Phase 1: events, divisions, point templates, finishes, rankings --------
// See plan section 1.3/1.4 (manual-parity subset; rating-engine models come later)

model Event {
  id          String   @id @default(cuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  name        String
  slug        String   @unique
  startDate   DateTime
  endDate     DateTime
  addressLine String?
  city        String?
  state       String?
  zip         String?
  isAnchor    Boolean  @default(false) // USAV Nationals / Triple Crown NIT -- exempt
  // from the future suggestion algorithm (Phase 4+); manually assigned max-value
  // templates always.
  isPriority  Boolean  @default(false) // marks events worth importing first / worth
  // running rankings against when not every event is imported yet. All events that
  // existed when this flag was introduced were backfilled to true (see migration);
  // new events default to unchecked since lower-priority events are expected going
  // forward.
  schedules     EventSchedule[] // one row per results/schedule page this event's
  // divisions are spread across -- most events have exactly one, but some run one
  // weekend split across several AES/Sportwrench schedule pages (e.g. separate pages
  // per age group); each gets its own row here and its own import batch, all landing
  // on this one Event.
  divisions     Division[]
  importBatches ImportBatch[]
  matches       Match[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([seasonId])
}

model EventSchedule {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String // e.g. "https://results.advancedeventsystems.com/event/PTAwMDAwMzg4Mzk90".
  source    ImportSource // which platform url points at. AES, Sportwrench, and
  // VBSchedule have working fetch implementations; TM2 can still be recorded here for
  // a future adapter, it just doesn't have a "Fetch" button yet.
  label     String? // optional, e.g. "15s/16s" -- distinguishes rows when an event
  // has more than one schedule link.
  createdAt DateTime     @default(now())

  @@index([eventId])
}

enum DivisionTierLabel {
  OPEN
  AMERICAN
  PATRIOT
  LIBERTY
  USA
  FREEDOM
  // AAU tiers -- distinct namespace from the USAV tiers above, but AAU events
  // never mix with USAV tiers within a single division, so one enum covers both.
  // USAV's "National" and AAU's "Premier" are treated as the same real-world tier
  // (top level below anchor events) and merged into this one value -- a label
  // containing either keyword parses to PREMIER, see TIER_KEYWORDS below.
  PREMIER
  CLUB
  CLASSIC
}

enum DivisionScoringStatus {
  DRAFT
  SUGGESTED
  CONFIRMED
}

enum DivisionGender {
  GIRLS
  BOYS
  COED
}

model Division {
  id                String                @id @default(cuid())
  eventId           String
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String // e.g. "17 Open"
  slug              String
  ageGroup          Int
  gender            DivisionGender        @default(GIRLS) // this platform was
  // girls-only until a real Sportwrench event surfaced boy divisions (label prefix
  // "B18"/"G18") -- default GIRLS matches every division imported before this field
  // existed, all confirmed girls-only in practice (see docs/domain-notes.md). Scoped
  // to the import layer only: ranking/rating engines still partition by
  // (season, ageGroup) alone, not gender -- see docs/plan.md's Sportwrench-import
  // section for why that's an explicitly deferred follow-up, not an oversight.
  tierLabel         DivisionTierLabel
  tierLevel         String? // e.g. "I" / "II" -- separate roman-numeral axis
  scoringStatus     DivisionScoringStatus @default(DRAFT)
  ignoreAgeDefault  Boolean               @default(false)
  pointBands        DivisionPointBand[]
  finishes          TeamFinish[]
  matches           Match[]
  importRows        ImportRow[]
  auditFlags        AuditFlag[]
  scoringSnapshots  DivisionScoringSnapshot[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([eventId, slug])
}

model PointTemplate {
  id              String              @id @default(cuid())
  name            String              @unique
  description     String?
  maxPoints       Int // denormalized top-band value, for sorting/display
  isAnchorTemplate Boolean            @default(false)
  isSystem        Boolean             @default(false)
  bands           PointTemplateBand[]
  suggestedInSnapshots DivisionScoringSnapshot[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PointTemplateBand {
  id              String        @id @default(cuid())
  pointTemplateId String
  pointTemplate   PointTemplate @relation(fields: [pointTemplateId], references: [id], onDelete: Cascade)
  fromRank        Int
  toRank          Int // 0 means "and beyond" (open-ended tail band), matching the
  // legacy convention seen in the admin screenshots.
  points          Int

  @@unique([pointTemplateId, fromRank])
}

model DivisionPointBand {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  fromRank   Int
  toRank     Int // 0 = open-ended tail band
  points     Int

  @@unique([divisionId, fromRank])
}

model TeamFinish {
  id             String   @id @default(cuid())
  divisionId     String
  division       Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  rank           Int // may repeat across rows for ties
  tiebreakOrder  Int? // AES-embedded unique seed/order number, display/ordering only
  points         Int? // resolved from DivisionPointBand at confirm time; null until then
  ignoreAge      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rankingContributions RankingResultContribution[]

  @@unique([divisionId, teamId])
  @@index([teamId])
}

// --- Phase 5: match-level results (feeds Elo/Massey, not built yet) ---------
// Populated by the MATCH_RESULTS import type (AES adapter -- see
// src/lib/import/aesMatches.ts and docs/plan.md §3/§6 Phase 5). Division/team
// resolution reuses whatever Division/TeamSeason rows the event's TEAM_FINISHES
// import already created -- a match import expects team finishes to already
// exist for the event, rather than re-deriving clubs/teams/divisions itself.
model Match {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])

  teamAId String?
  teamA   Team?   @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamBId String?
  teamB   Team?   @relation("MatchTeamB", fields: [teamBId], references: [id])

  winnerTeamId String?
  winner       Team?   @relation("MatchWinner", fields: [winnerTeamId], references: [id])

  matchDate DateTime?
  stage     String? // e.g. "Round 1 Pool C", "Gold Bracket" -- AES's Play.FullName, display-only
  setsA     Int
  setsB     Int
  setScores Json // [{ a: number, b: number }, ...] per-set point scores, in order

  externalMatchId String // AES's numeric MatchId (string form) -- idempotent re-import key
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eloMatchSteps TeamEloMatchStep[]

  @@unique([eventId, externalMatchId])
  @@index([divisionId])
  @@index([teamAId])
  @@index([teamBId])
}

// Persisted per-team, per-match trace of computeEloRatingsForPartition()'s replay --
// written by that function (delete-and-replace by (seasonId, ageGroup), same pattern
// as TeamRatingHistory) so getTeamEloHistory() can read a team's match-by-match Elo
// history directly instead of re-replaying the entire (season, ageGroup) partition's
// match graph on every team-detail page view (that replay -- fetching every division/
// match in the partition, then computeMatchDivisionWeights()'s per-division N+1 --
// was the dominant cost on that page; see docs/plan.md). Elo's replay is strictly
// chronological, so a match's before/after values here are already final regardless
// of which later matches get added -- only a *future* recompute changes past rows,
// not a caller's asOfDate.
model TeamEloMatchStep {
  id             String @id @default(cuid())
  matchId        String
  match          Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team   @relation("TeamEloMatchStepTeam", fields: [teamId], references: [id])
  opponentTeamId String
  opponent       Team   @relation("TeamEloMatchStepOpponent", fields: [opponentTeamId], references: [id])
  seasonId       String
  season         Season @relation(fields: [seasonId], references: [id])
  ageGroup       Int // the team's own natural age-group partition this step belongs to

  won                  Boolean
  thisTeamSets         Int
  opponentSets         Int
  ratingBefore         Float
  ratingAfter          Float
  opponentRatingBefore Float
  expected             Float // this team's win probability going into the match
  k                    Int
  effectiveWeight      Float
  multiplier           Float
  divisionWeight       Float
  isOpenDivision       Boolean

  createdAt DateTime @default(now())

  @@unique([matchId, teamId])
  @@index([teamId, seasonId, ageGroup])
}

model RankingResult {
  id             String   @id @default(cuid())
  seasonId       String
  ageGroup       Int
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  totalPoints    Int
  rank           Int
  weightedRank   Int
  algorithmVersion String @default("phase1-points-only")
  computedAt     DateTime @default(now())

  contributions RankingResultContribution[]

  @@unique([seasonId, ageGroup, teamId])
  @@index([seasonId, ageGroup, rank])
  @@index([teamId])
}

// --- Phase 3: Tier 1 rating engine (Colley) ----------------------------------
// See docs/plan.md §2/§6 (Phase 3). Weekly persisted snapshot per (team, season,
// ageGroup) -- mirrors RankingResult's delete-and-replace-by-partition pattern, keyed
// here by weekEndingDate instead of always representing "current."

enum RatingEngine {
  COLLEY
  ELO
  MASSEY
}

model TeamRatingHistory {
  id             String       @id @default(cuid())
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id])
  seasonId       String
  season         Season       @relation(fields: [seasonId], references: [id])
  ageGroup       Int
  weekEndingDate DateTime
  ratingEngine   RatingEngine @default(COLLEY)
  rating         Float
  rank           Int
  comparisons    Int // count of inferred pairwise win/loss comparisons feeding this
  // rating (NOT real matches played -- see docs/plan.md; Phase 5's match-level data
  // will supersede this). Powers the future NO_HISTORY / LOW_PERCENT_RATED confidence
  // warnings (Phase 3 FSS work).
  createdAt      DateTime     @default(now())

  @@unique([teamId, seasonId, ageGroup, weekEndingDate, ratingEngine])
  @@index([seasonId, ageGroup, weekEndingDate])
}

// State machine on the entity (Division.scoringStatus), audit trail here -- see
// prisma/CLAUDE.md's "state machine on the entity, audit trail in a separate table"
// pattern. One Division can accumulate many snapshots over time (e.g. re-suggested
// after more of the season's Colley graph connects); the latest is "current." Not a
// live view -- fields are captured at generation time so accept/override history
// stays legible even as ratings keep moving.
enum DivisionScoringSnapshotStatus {
  PENDING
  ACCEPTED
  OVERRIDDEN
}

model DivisionScoringSnapshot {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  ratingEngineUsed String? // "ELO" | "COLLEY" -- which pipeline produced fss/elitePresence/
  // percentile below (see computeDivisionScoringSuggestion.ts). ELO (the DCI blend,
  // see dci.ts) is used once a division's teams have Elo ratings (imported Match
  // data); COLLEY (the original FSS/elitePresence blend) is the fallback otherwise.
  // Null on snapshots created before this field existed.
  teamCount         Int
  ratedTeamCount    Int
  percentTeamsRated Float
  fss               Float? // null when no team in the field is rated yet (NO_HISTORY).
  // Colley path: mean Colley rating of the top half. Elo path: mean Elo of the top
  // quartile (DCI's Strength of Field input) -- see ratingEngineUsed.
  elitePresence Float? // Colley path: % of the population's nationally elite (rank <=
  // 50) teams present in this division (fieldStrength.ts computeElitePresence),
  // population-relative. Elo path: % of THIS division's own Elo-rated teams at or
  // above ELO_ELITE_THRESHOLD (dci.ts computeIntrinsicElitePresence), intrinsic to the
  // division -- see ratingEngineUsed for which. Null when no elite teams/ratings exist
  // yet.
  percentile Float? // FSS's percentile within the full (season, ageGroup) rating
  // population, blended with elitePresence (see suggestPointTemplate.ts
  // blendPercentileWithElitePresence for the Colley path, dci.ts computeDci for the
  // Elo path) -- this is what makes the suggestion self-calibrating rather than a
  // fixed FSS cutoff (see docs/plan.md §2), and what drives scoreBand/suggestedTemplate
  // below. Null alongside fss.
  scoreBand   String? // plain-language band, e.g. "Elite field" -- cutoffs TBD, Phase 4
  matchVolume Int // one of the two raw scale-factor inputs (see fieldStrength.ts)
  bucketCounts Json // Record<threshold, count>, mirrors the legacy Analysis screen

  warnings String[] // SMALL_FIELD | NO_HISTORY | LOW_PERCENT_RATED

  suggestedTemplateId String?
  suggestedTemplate    PointTemplate? @relation(fields: [suggestedTemplateId], references: [id])

  status         DivisionScoringSnapshotStatus @default(PENDING)
  overrideReason String? // required by the UI whenever status flips to OVERRIDDEN --
  // feeds future recalibration (docs/plan.md §2)

  createdAt DateTime @default(now())

  @@index([divisionId, createdAt])
}

model RankingResultContribution {
  id              String        @id @default(cuid())
  rankingResultId String
  rankingResult   RankingResult @relation(fields: [rankingResultId], references: [id], onDelete: Cascade)
  teamFinishId    String
  teamFinish      TeamFinish    @relation(fields: [teamFinishId], references: [id], onDelete: Cascade)
  points          Int
  rankInSeason    Int // 1st/2nd/3rd/4th... best finish, by points descending
  countedInTop3   Boolean

  @@unique([rankingResultId, teamFinishId])
  @@index([teamFinishId])
}

// --- Phase 7: club-level ranking ---------------------------------------------
// See docs/plan.md §8. Rolls up an existing team-level per-team rank per (season,
// club): the club's single highest-ranked team in each age group (13-18) maps rank
// to a linear 101-rank point value, weighted 20% flat per age group, best 5 of 6
// summed. Mirrors RankingResult/RankingResultContribution's delete-and-replace-by-
// partition pattern (partitioned by seasonId+source here, not seasonId+ageGroup,
// since a club's score spans every age group at once). v1 limitation: does not yet
// account for a club holding multiple Club rows (different externalCode/region)
// that are really the same real-world program -- see the club-alias/grouping note
// in docs/plan.md §8; each Club row is ranked independently for now.

enum ClubRankingSource {
  NPS // per-team rank = RankingResult.rank (points-based finishes)
  COMBINED // per-team rank = the Combined Rankings blend (50% NPS rank + 50% Power
  // Rankings' Avg Rank) -- see computeCombinedRankByTeam in powerRankings.ts.
}

model ClubRankingResult {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id])
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id])
  source       ClubRankingSource @default(NPS) // which per-team ranking this rollup
  // is built from -- NPS and COMBINED are computed and stored independently, shown
  // as separate tabs on /admin/club-rankings, not blended together.
  totalPoints  Float // weighted sum of the best 5 of 6 age-group scores -- Float
  // (unlike RankingResult.totalPoints, which is raw Int points), since this is
  // already post-20%-weighting.
  rank         Int // position within the two-tier sort: qualified clubs by score
  // first, then under-qualified clubs by score -- see isQualified.
  isQualified  Boolean // 3+ age groups with a team ranked in that age group's own
  // top 100 (see docs/plan.md §8 point 1). Under-qualified clubs are still scored
  // and ranked, just sorted after every qualified club.
  algorithmVersion String @default("phase7-v1")
  computedAt   DateTime @default(now())

  contributions ClubRankingResultContribution[]

  @@unique([seasonId, clubId, source])
  @@index([seasonId, source, isQualified, rank])
}

model ClubRankingResultContribution {
  id                  String            @id @default(cuid())
  clubRankingResultId String
  clubRankingResult   ClubRankingResult @relation(fields: [clubRankingResultId], references: [id], onDelete: Cascade)
  ageGroup            Int // 13-18
  teamId              String? // the club's best-ranked team in this age group;
  // null if the club has no ranked team at all in this age group.
  team                Team?             @relation(fields: [teamId], references: [id])
  rank                Int? // that team's RankingResult.rank for this age group
  rawPoints           Int? // 101 - rank, ties already baked into rank
  weightedPoints      Float? // rawPoints * 0.20
  countedInBest5      Boolean // false for the one dropped (lowest) age-group slot

  @@unique([clubRankingResultId, ageGroup])
}

// --- Legacy 5-year club ranking (historical seed + rolling aggregate) -------
// Bridges legacy v1's already-computed club-ranking output (2021-2025, imported from
// a hand-maintained workbook -- see prisma/importLegacyClubRankings.ts) into a real
// computed "5-Year Aggregate" used for NIT invites/housing priority. Unlike
// ClubRankingResult (Phase 7), which is computed from this app's own imported
// TeamFinish/RankingResult data one Season at a time, these per-year totals for
// 2021-2024 have no underlying event/division/team-finish data in this app at all --
// the legacy workbook's own already-finalized per-year score is the ground truth for
// those years, not something this app can recompute. `source` defaults to
// "LEGACY_IMPORT" but is a plain String (not an enum) specifically to leave room for
// a future "COMPUTED" value once enough of this app's own seasons exist to fold into
// the rolling 5-year window without a schema change.
model ClubAnnualScore {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  year        Int
  totalPoints Float
  legacyRank  Int? // the rank shown in the source workbook that year -- reference/QA
  // only, never used by computeFiveYearClubRankingForYear (which always re-derives
  // rank from totalPoints, same as every other ranking result in this app).
  source    String   @default("LEGACY_IMPORT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, year])
  @@index([year])
}

// Per-age-group breakdown underlying a club's ClubAnnualScore for a given year --
// only populated for 2025 so far (the only year the source workbook has this level of
// detail for; see prisma/importLegacyClubRankings.ts). No Team FK: these historical
// teams mostly don't correspond to any Team row this app has itself imported, so
// teamName/teamCode are kept as plain reference strings rather than forcing a fuzzy
// match into the Team table.
model ClubAnnualAgeGroupScore {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  year       Int
  ageGroup   Int
  teamName   String?
  teamCode   String?
  rank       Int?
  npsPoints  Int?
  clubPoints Int? // already-computed rank -> points value from the source workbook,
  // matches rankToPoints() in clubRanking.ts -- kept as imported rather than
  // re-derived, since this is historical reference data, not something this app scores.
  createdAt DateTime @default(now())

  @@unique([clubId, year, ageGroup])
}

// Delete-and-replace-by-partition result of the recency-weighted 5-year blend (see
// src/lib/ranking/fiveYearClubRanking.ts), partitioned by endYear (the window is
// [endYear-4, endYear]) instead of seasonId -- ClubAnnualScore isn't season-scoped,
// so there's no Season row to key off for the legacy years. Same audit-trail shape as
// ClubRankingResult/ClubRankingResultContribution (prisma/CLAUDE.md).
model ClubFiveYearRankingResult {
  id               String   @id @default(cuid())
  endYear          Int
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id])
  totalPoints      Float
  rank             Int
  algorithmVersion String   @default("phase-5yr-v1")
  computedAt       DateTime @default(now())

  contributions ClubFiveYearRankingResultContribution[]

  @@unique([endYear, clubId])
  @@index([endYear, rank])
}

model ClubFiveYearRankingResultContribution {
  id                          String                    @id @default(cuid())
  clubFiveYearRankingResultId String
  clubFiveYearRankingResult   ClubFiveYearRankingResult @relation(fields: [clubFiveYearRankingResultId], references: [id], onDelete: Cascade)
  year                        Int
  weight                      Float // 0.05/0.15/0.20/0.25/0.35, oldest to newest
  points                      Float // 0 when the club had no ClubAnnualScore that year
  weightedPoints              Float
  present                     Boolean // false when defaulted to 0 (no ClubAnnualScore row)

  @@unique([clubFiveYearRankingResultId, year])
}

// --- Phase 2: CSV import pipeline (AES adapter, TEAM_FINISHES only) ---------
// See docs/plan.md Phase 2 section for the full resolve/commit algorithm.

enum ImportSource {
  AES
  SPORTWRENCH
  TM2
  VBSCHEDULE
  MANUAL
}

enum ImportType {
  DIVISIONS
  TEAM_FINISHES
  MATCH_RESULTS
}

enum ImportBatchStatus {
  DRAFT
  RESOLVED
  COMMITTED
  FAILED
}

enum ImportFileStatus {
  UPLOADED
  PARSED
  ERROR
}

enum ImportRowStatus {
  PENDING
  OK
  WARNING
  ERROR
}

enum ImportMatchType {
  EXISTING
  NEW
  AMBIGUOUS
}

enum AuditFlagType {
  NEW_CLUB
  NEW_TEAM
  NEW_DIVISION
  REGION_MISMATCH
  TIER_DEFAULTED
  DUPLICATE_IN_IMPORT
  REIMPORT_UPDATE
  OTHER
}

// One import batch targets a single Event -- an AES file spans that whole event's
// age groups/tiers at once, so one batch's commit can create/touch many Divisions.
model ImportBatch {
  id          String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id])
  source      ImportSource      @default(AES)
  importType  ImportType        @default(TEAM_FINISHES)
  status      ImportBatchStatus @default(DRAFT)
  scheduleUrl    String? // frozen copy of the EventSchedule (url/source) this batch
  // was started from -- same frozen-copy pattern as DivisionPointBand (see
  // prisma/CLAUDE.md): a batch keeps using the link it was created with even if the
  // event's EventSchedule rows change later. Null for batches driven purely by
  // manually-uploaded CSVs with no fetchable schedule.
  scheduleSource ImportSource?
  summaryJson Json? // display cache of row-status + new-club/team/division counts,
  // refreshed after resolve/commit -- mirrors the Division.scoringStatus-coarse-field
  // / audit-trail-detail pattern used elsewhere; ImportRow is the real detail.
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  files       ImportFile[]
  auditFlags  AuditFlag[]
  matches     Match[]
  committedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventId])
}

model ImportFile {
  id            String           @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  filename      String
  partNumber    Int? // parsed from "_part1"/"_part2" in filename; null for a single-file batch
  rawContent    String // full CSV text -- stored directly (no blob storage exists in
  // this project; AES's ~300-line-per-file cap keeps this small), also lets "resolve"
  // replay from scratch without re-upload.
  status     ImportFileStatus @default(UPLOADED)
  parseError String?
  rowCount   Int              @default(0)
  rows       ImportRow[]
  createdAt  DateTime         @default(now())

  @@unique([importBatchId, filename])
}

// Staging row for the preview screen. Raw AES columns are explicit typed fields
// (not a generic JSON blob) since AES's 4-column shape is fixed and known.
model ImportRow {
  id           String     @id @default(cuid())
  importFileId String
  importFile   ImportFile @relation(fields: [importFileId], references: [id], onDelete: Cascade)
  rowNumber    Int // 1-based row number within the file, for error display

  // raw, exactly as read from the CSV's 4 AES columns
  ageGroupLabelRaw String
  rankRaw          String
  teamNameRaw      String
  teamCodeRaw      String

  // parsed, populated by resolveImportBatch()
  parsedRank               Int?
  parsedAgeGroup            Int? // the DIVISION's nominal age group, from ageGroupLabelRaw --
  // for a combined-age label ("12/13 Club") this is the older/max age, per domain
  // convention that a combined bracket is "for" the older age and a younger team
  // playing in it is the one playing up (see parsedTeamAgeGroup + docs/plan.md).
  parsedTeamAgeGroup        Int? // this TEAM's own real age group, decoded from its
  // team code (always structurally reliable, unlike the free-text label). Differs
  // from parsedAgeGroup exactly when this team is playing up in a combined/mismatched
  // division -- that comparison is what drives TeamFinish.ignoreAge at commit time.
  parsedTierLabel           DivisionTierLabel?
  parsedTierLevel           String?
  tierWasDefaulted          Boolean            @default(false)
  parsedGender              String? // raw gender char straight from the team code
  // (e.g. "g"/"b") -- audit-only, kept separate from the resolved enum below.
  parsedDivisionGender      DivisionGender? // resolved GIRLS/BOYS value actually used
  // for division matching/creation -- from the team code authoritatively, cross-
  // checked (not overridden) against the division label's optional "B"/"G" prefix.
  // See resolve.ts.
  parsedClubExternalCode    String?
  parsedTeamNumber          String? // alphanumeric -- see TeamSeason.teamNumber
  parsedRegionCodeFromCode  String?
  parsedRegionCodeFromName  String?
  parsedTiebreakOrder       Int?
  teamNameClean             String?

  // resolve output
  status   ImportRowStatus @default(PENDING)
  messages String[]

  divisionMatchType ImportMatchType?
  matchedDivisionId String?
  matchedDivision   Division? @relation(fields: [matchedDivisionId], references: [id])

  clubMatchType ImportMatchType?
  matchedClubId String?
  matchedClub   Club? @relation(fields: [matchedClubId], references: [id])

  teamMatchType ImportMatchType?
  matchedTeamId String?
  matchedTeam   Team? @relation(fields: [matchedTeamId], references: [id])

  existingTeamFinishId String? // set when TeamFinish(divisionId,teamId) already
  // exists -- commit updates it instead of erroring (re-import idempotency).

  // admin overrides -- sticky across re-resolve. Plain id strings, not relations:
  // write-mostly pointer fields, not worth six more relation names to the same
  // three target models.
  overrideDivisionId String?
  overrideClubId     String?
  overrideTeamId     String?
  overrideClubName   String? // required before commit whenever the effective club match is NEW
  excluded           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importFileId])
  @@index([status])
}

model AuditFlag {
  id            String        @id @default(cuid())
  importBatchId String?
  importBatch   ImportBatch?  @relation(fields: [importBatchId], references: [id])
  type          AuditFlagType
  message       String
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id])
  clubId        String?
  club          Club?         @relation(fields: [clubId], references: [id])
  divisionId    String?
  division      Division?     @relation(fields: [divisionId], references: [id])
  resolved      Boolean       @default(false) // no UI to flip this yet -- Phase 6 (/admin/flags)
  createdAt     DateTime      @default(now())

  @@index([importBatchId])
  @@index([teamId])
  @@index([clubId])
  @@index([divisionId])
}
