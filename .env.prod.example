# Copy to .env.prod on the homelab Docker host, fill in real values.

POSTGRES_PASSWORD=change-me

# Auth.js session signing secret — generate with: openssl rand -base64 33
AUTH_SECRET=change-me

# Required when the app sits behind a reverse proxy (Traefik/nginx/etc.) or is
# reached by a hostname other than localhost.
AUTH_TRUST_HOST=true

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
